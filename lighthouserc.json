{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": { "preset": "perf", "formFactor": "mobile", "screenEmulation": { "mobile": true } },
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/cursos-de-ingles/",
        "http://localhost:3100/empresas-e-profissionais/",
        "http://localhost:3100/comofunciona/",
        "http://localhost:3100/agendamento/",
        "http://localhost:3100/blog/",
        "http://localhost:3100/como-usar-a-tecnica-star-para-entrevistas/",
        "http://localhost:3100/contato/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouse/ci" }
  }
}
